<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read GGUF model from /data/local/tmp/llm/ (no permission needed for adb-pushed files)  -->
    <!-- Write benchmark results to app-specific external storage (no permission needed API 29+) -->
    <!-- Legacy storage permission for devices below Android 10 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/scigemmaicon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SciGemma"
        tools:targetApi="31">

        <activity
            android:name="com.example.scigemma.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SciGemma">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OpenCL libraries removed (llama.cpp uses CPU / optional Vulkan) -->

    </application>

</manifest>
